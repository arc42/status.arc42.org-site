<!-- golang template for arc42 usage statistics table -->
<!-- with addons to make it sortable with DataTables -->
<!--
  The table answers "how is the family doing" - one row per property, reach over
  three horizons. It no longer carries the "Open Tasks" columns (issues, bugs,
  PRs): that data answers "what needs me", which is the tiles' question, and a
  number sitting in a sortable table invites comparison between repositories
  that says nothing useful.

  Eight columns: site, status, and 2 x 3 visitor/pageview columns.

  It also carries fewer rows than the dashboard has tiles. Only properties
  marked InTable appear here (types.Arc42properties): a column is read downwards,
  and rows that do not compare with each other - a CLI's landing page, a
  repository with no site at all - make that reading worse rather than more
  complete. Their numbers are on their own subpages. The totals row sums
  exactly the rows above it, so the reader can check it by adding up.

  The rollup's unique count is not shown here: it is for maintainers only, on
  the service's /rollup page (ADR-0022).
-->
{{ with .Availability }}
<!-- The verdict is rendered by the service, not by Jekyll: only the
     process that read the data may summarise it. When the service is
     unreachable the static shell shows its error panel instead, so a
     stale build can never claim anything (ADR-0019 honesty chain). -->
<p class="status-verdict">
    <span class="status-token status-token--{{ .Token }}" role="img" aria-label="{{ .Token }}"></span>
    <span>{{ if not .Measured }}<b>Availability is not measured yet.</b>
        The prober has not recorded any data; the Status column fills itself
        from its first run onward.
    {{ else if .Stale }}<b>Availability data is stale.</b>
        Last successful check {{ .LastCheckedAgo }} &mdash; showing the last
        known state as &ldquo;unknown&rdquo;, not as green.
    {{ else if .AllUp }}<b>All {{ .NrMonitored }} sites up.</b>
        Checked every ~15 minutes; last check {{ .LastCheckedAgo }}.
    {{ else }}<b>{{ if .NrDown }}{{ .NrDown }} down{{ end }}{{ if and .NrDown .NrDegraded }}, {{ end }}{{ if .NrDegraded }}{{ .NrDegraded }} degraded{{ end }}</b>
        of {{ .NrMonitored }} monitored sites. Last check {{ .LastCheckedAgo }}.{{ end }}</span>
</p>
{{ end }}
<table id="sortableStatsTable" class="display">
    <caption class="visually-hidden">
        Visitors and page views per arc42 site, over 7 days, 30 days and 12 months.
        The Status column shows current availability and 30-day uptime; "n/a" means the measurement window is not filled yet.
        Sites without traffic measurement show "n/a" rather than zero.
        Properties reported only on their own detail page are not listed here.
    </caption>
    <thead>
    <tr>
        <!-- the gopher is decoration; the column still needs a name for
             screen readers and for the DataTables sort control -->
        <th rowspan="2" scope="col"><img src="/images/minion-logo-100px.png" alt=""><span class="visually-hidden">Site</span></th>
        <th rowspan="2" scope="col" class="border-left-black text-center">Status</th>
        <th colspan="2" scope="colgroup" class="border-left-black text-center">7 Days</th>
        <th colspan="2" scope="colgroup" class="border-left-black text-center">30 Days</th>
        <th colspan="2" scope="colgroup" class="border-left-black text-center">12 Month</th>
    </tr>
    <tr>
        <th scope="col" class="border-left-black">Visitors</th>
        <th scope="col">PageViews</th>
        <th scope="col" class="border-left-black">Visitors</th>
        <th scope="col">PageViews</th>
        <th scope="col" class="border-left-black">Visitors</th>
        <th scope="col">PageViews</th>
    </tr>
    </thead>

    <tbody>

    {{ range .TableRows }}
        <!-- row--unmeasured marks a site with no Plausible site at all: its
             cells read "n/a", and CSS may quiet them so they are not mistaken
             for a measured zero. data-site repeats the tile/band registry key
             on the row itself, so the accent bar below can borrow that
             property's registered hue (assets/css/arc42-status-style.css)
             instead of the table inventing a colour of its own. -->
        <tr class="stats-row{{ if not .HasTraffic }} row--unmeasured{{ end }}" data-site="{{ .Site }}">
            <!-- Goes to the property's tile on this same page, not straight
                 to the detail page and not to the property itself: the table
                 is the overview, the tile is the next thing down from it, and
                 the detail page is a level below that (reachable from the
                 tile's own band or "all detail on" link). -->
            <th scope="row"><a href="/#tile-{{ .Site }}">{{ .Site }}</a></th>
            <td class="status-cell border-left-black" data-order="{{ printf "%.2f" .Availability.Uptime30dNr }}">
                <a class="status-cell__link" href="/site/{{ .Site }}/#availability"
                   aria-label="availability of {{ .Site }}: {{ .Availability.Token }}, 30 days {{ .Availability.Uptime30d }}">
                    <span class="status-token status-token--{{ .Availability.Token }}" role="img" aria-hidden="true"></span><span
                       class="status-cell__pct">{{ if eq .Availability.Uptime30d "n/a" }}{{ if eq .Availability.State "up" }}ok{{ else }}{{ .Availability.State }}{{ end }}{{ else }}{{ .Availability.Uptime30d }}{{ end }}</span>
                </a>
            </td>
            <td class="border-left-black">{{ .Visitors7d}}</td>
            <td>{{ .PageViews7d}}</td>
            <td class="border-left-black">{{ .Visitors30d}}</td>
            <td>{{ .PageViews30d}}</td>
            <td class="border-left-black">{{ .Visitors12m}}</td>
            <td>{{ .PageViews12m}}</td>
        </tr>
    {{ end }}
    </tbody>

    <tfoot> <tr>
        <th scope="row" class="border-top text-right">Totals:</th>
        <td class="border-top border-left-black"></td>
        <td class="border-top border-left-black text-right">{{ .Totals.SumOfVisitors7d}}</td>
        <td class="border-top text-right">{{ .Totals.SumOfPageViews7d}}</td>
        <td class="border-top border-left-black text-right">{{ .Totals.SumOfVisitors30d}}</td>
        <td class="border-top text-right">{{ .Totals.SumOfPageViews30d}}</td>
        <td class="border-top border-left-black text-right">{{ .Totals.SumOfVisitors12m}}</td>
        <td class="border-top text-right">{{ .Totals.SumOfPageViews12m}}</td>
    </tr> </tfoot>
</table>


<br>
<div style="font-size: 12px; padding-bottom: 14px; display: flex; align-items: center; flex-wrap: wrap; gap: 8px;">
    <span>
        Data collected in {{ .HowLongDidItTake }} msecs by arc42 statistics service
        (v. {{.AppVersion}}) at {{.LastUpdatedString }}
        running {{if .FlyRegion}}
            on <a href="https://fly.io" target="_blank" rel="noopener"> fly.io </a>
            in {{.WhereDoesItRun}} (region {{.FlyRegion}})
        {{ else }}
            {{.WhereDoesItRun}}
        {{ end}}
    </span>
    <a href="https://cron-job.org" target="_blank" rel="noopener" title="Availability Prober Status on cron-job.org">
        <img src="https://api.cron-job.org/jobs/8230558/dd3e1a288f7215d8/status-7.svg" alt="Cron job status" style="height: 18px; vertical-align: middle;">
    </a>
</div>
