<!-- golang template for the arc42 dashboard tiles -->
<!--
  One tile per property, in the card shape of the brand manual: a coloured band
  carries identity (the site name), the body carries state (what is open, what
  just closed). Band = who, body = how.

  NO COLOUR VALUE IS EMITTED HERE. The tile only says data-site="<key>"; every
  hue - band background, band text, rim - is chosen in CSS from that attribute
  via custom properties (ADR-0003: CSS custom properties are the only token
  interface). Go must never learn a hex value.

  The tile is a summary, not a tracker: three counts, at most three open items
  and two recently closed ones, and a link to the property's own page where the
  lists are complete. The caps live in Go (types.TileOpenShown /
  TileClosedShown) so the template does no arithmetic.

  Class contract for the stylesheet:
    .tile-grid                     grid wrapper, htmx swap target (#tileGrid)
    .tile-allclear                 "nothing is waiting for you" banner
    .tile[data-site]               one card; .tile--hub, .tile--attention
      .tile__band                  coloured identity band
        .tile__site > .tile__sitelink    site name (h3 + link to /site/<key>/)
        .tile__role                "hub" / "repository" marker
      .tile__body                  state
        .tile__stats > .tile__stat (.tile__stat--flagged)
                       > .tile__statnr + .tile__statlabel
        .tile__lists               the two lists, side by side on wide tiles
        .tile__subhead             "Recently closed"
        .tile__items > .tile__item (.tile__item--untriaged)
                       > .tile__itemlink + .tile__meta
                         > .tile__kind, .tile__age, .tile__untriaged
        .tile__closed > .tile__closeditem
                       > .tile__itemlink + .tile__meta
                         > .tile__kind, .tile__ago
        .tile__empty               "nothing open"
      .tile__more > .tile__morelink    link to the per-site subpage
-->
<div id="tileGrid" class="tile-grid">

    {{ $hasWork := false }}
    {{ range .Tiles }}{{ if gt .NrUntriaged 0 }}{{ $hasWork = true }}{{ end }}{{ end }}

    {{ if not $hasWork }}
    <p class="tile-allclear" role="status">
        <span class="status-token status-token--up" role="img" aria-label="all clear"></span>
        <span><b>Nothing is waiting for you.</b> Nothing untriaged across
        {{ len .Tiles }} properties: every open item carries a label, and none arrived
        in the last 30 days.</span>
    </p>
    {{ end }}

    {{ range .Tiles }}
    <article class="tile{{ if .IsHub }} tile--hub{{ end }}{{ if gt .NrUntriaged 0 }} tile--attention{{ end }}"
             data-site="{{ .Site }}">

        <!-- The title goes to /site/<key>/, not to the property itself. A tile
             is a way into this dashboard's own detail page; sending the most
             prominent link on it off to another domain made the tile a
             departure lounge. "Visit the site" lives on the subpage, where a
             reader who wants the property itself will look for it. -->
        <div class="tile__band">
            <h3 class="tile__site"><a class="tile__sitelink" href="/site/{{ .Site }}/">{{ .Site }}</a></h3>
            {{ if .IsHub }}<span class="tile__role">hub</span>
            {{ else if not .Host }}<span class="tile__role">repository</span>{{ end }}
        </div>

        <div class="tile__body">

            <!-- The three counts, one row, one typographic weight. Untriaged
                 used to be a 1.9rem headline below this strip; it is the same
                 kind of fact as the other two and now reads as one. -->
            <p class="tile__stats">
                <a class="tile__stat" href="{{ .Repo }}/issues"><span class="tile__statnr">{{ .NrOfOpenIssues }}</span>
                    <span class="tile__statlabel">open {{ if eq .NrOfOpenIssues 1 }}issue{{ else }}issues{{ end }}</span></a>
                <a class="tile__stat" href="{{ .Repo }}/pulls"><span class="tile__statnr">{{ .NrOfOpenPRs }}</span>
                    <span class="tile__statlabel">open {{ if eq .NrOfOpenPRs 1 }}PR{{ else }}PRs{{ end }}</span></a>
                <!-- not a link: "untriaged" means unlabelled OR newer than 30
                     days, and no GitHub search expresses the second half. A
                     link that filters on only one of them would be a promise
                     the destination breaks. -->
                <span class="tile__stat{{ if gt .NrUntriaged 0 }} tile__stat--flagged{{ end }}"><span class="tile__statnr">{{ .NrUntriaged }}</span>
                    <span class="tile__statlabel">untriaged</span></span>
            </p>

            <div class="tile__lists">
                {{ if .TopOpen }}
                <ul class="tile__items" aria-label="most recent open issues and pull requests on {{ .Site }}">
                    {{ range .TopOpen }}
                    <li class="tile__item{{ if .Untriaged }} tile__item--untriaged{{ end }}">
                        <a class="tile__itemlink" href="{{ .URL }}">{{ .Title }}</a>
                        <span class="tile__meta">
                            <span class="tile__kind">{{ if .IsPR }}PR{{ else }}issue{{ end }}</span>
                            <span class="tile__age">{{ .AgeString }}</span>
                            {{ if .Untriaged }}<span class="tile__untriaged">untriaged</span>{{ end }}
                        </span>
                    </li>
                    {{ end }}
                </ul>
                {{ else }}
                <p class="tile__empty">nothing open</p>
                {{ end }}

                {{ if .TopClosed }}
                <div class="tile__closedgroup">
                    <h4 class="tile__subhead">Recently closed</h4>
                    <ul class="tile__closed">
                        {{ range .TopClosed }}
                        <li class="tile__closeditem">
                            <a class="tile__itemlink" href="{{ .URL }}">{{ .Title }}</a>
                            <span class="tile__meta">
                                <span class="tile__kind">{{ if .IsPR }}PR{{ else }}issue{{ end }}</span>
                                <span class="tile__ago">closed {{ .ClosedAgo }}</span>
                            </span>
                        </li>
                        {{ end }}
                    </ul>
                </div>
                {{ end }}
            </div>

        </div>

        <p class="tile__more">
            <a class="tile__morelink" href="/site/{{ .Site }}/">{{ if gt .MoreOpen 0 }}… and {{ .MoreOpen }} more on {{ .Site }}{{ else }}… all detail on {{ .Site }}{{ end }}</a>
        </p>

        <!-- The availability slot goes here once ADR-0019 collects data. It is
             deliberately absent while nothing is measured: the verdict line
             above the grid says "not monitored" once, and repeating it on every
             tile would be eleven copies of the same non-information. -->
    </article>
    {{ end }}
</div>
