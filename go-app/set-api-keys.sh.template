#!/bin/bash
#
# TEMPLATE -- copy to set-api-keys.sh and fill in the real values:
#
#     cp set-api-keys.sh.template set-api-keys.sh
#
# set-api-keys.sh contains live secrets and is listed in go-app/.gitignore.
# It has never been committed; keep it that way. This template is the only
# version of the file that belongs in git.
#
# `make backend` sources it for you. To run the service by hand instead:
#
#     source ./set-api-keys.sh && go run main.go

# Plausible.io API key -- read access to the arc42 site statistics.
export PLAUSIBLE_API_KEY=<plausible-api-key>

# GitHub personal access token, used for the issues/bugs/PRs GraphQL queries.
# Named GITHUB_API_KEY here; in GitHub Actions the same secret is called
# GRAPHQL_API_TOKEN, because GitHub forbids secret names starting with GITHUB_.
export GITHUB_API_KEY=<github-personal-access-token>

# Slack bot token, for the notifications described in ADR-0016.
export SLACK_AUTH_TOKEN=<slack-bot-token>

# Long-lived Turso token, created on the command line with
#   turso db tokens create arc42-statistics
export TURSO_AUTH_TOKEN="<turso-auth-token>"

# ---- maintainer login for the rollup page (ADR-0022) ----------------------
# Without the first four, /rollup answers 503; everything else runs as usual.

# GitHub OAuth App "arc42 status (local)", authorization callback URL
#   http://localhost:8043/auth/callback
export GITHUB_OAUTH_CLIENT_ID=<oauth-app-client-id>
export GITHUB_OAUTH_CLIENT_SECRET=<oauth-app-client-secret>

# Signs the login cookies. Generate with:  openssl rand -base64 32
# Changing it signs every maintainer out.
export SESSION_KEY=<openssl-rand-base64-32>

# Where this service is reachable; the OAuth callback URL is built from it.
export PUBLIC_BASE_URL="http://localhost:8043"

# Plausible shared link for rollup.arc42.com, without &embed=... .
# Secret: whoever holds it can read the rollup dashboard.
export PLAUSIBLE_ROLLUP_SHARE_URL=<plausible-share-link>

# DEV keeps the service on the development database and off the production
# one. Anything starting with DEV, TEST or PROD is recognised; see
# internal/env/environment.go.
export ENVIRONMENT="DEV"

# zerolog levels, highest to lowest:
#   panic, fatal, error, warn, info, debug, trace
export LOGLEVEL="INFO"

echo "API tokens set (from set-api-keys.sh)."
echo "  ENVIRONMENT: ${ENVIRONMENT}"
echo "  LOGLEVEL:    ${LOGLEVEL}"
